[
  {
    "id": "光光安全小剧场第三季-01",
    "series": "光光安全小剧场第三季",
    "n": 1,
    "title": "陌生人敲门先问清",
    "announce": "请听。光光安全小剧场第三季。第1集。陌生人敲门先问清。",
    "lines": [
      {
        "who": "gg",
        "text": "第三季安全开场：咚咚咚，有人敲门。"
      },
      {
        "who": "xw",
        "text": "开门！会不会送披萨？"
      },
      {
        "who": "gg",
        "text": "先通过门镜或猫眼看，隔门问是谁。爸妈不在，不随便开。"
      },
      {
        "who": "xw",
        "text": "他说他是修水管的呢？"
      },
      {
        "who": "gg",
        "text": "没约定就不开。打电话给家里大人核实。"
      },
      {
        "who": "xw",
        "text": "我学会隔门问话了！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-02",
    "series": "光光安全小剧场第三季",
    "n": 2,
    "title": "食品过期不凑合",
    "announce": "请听。光光安全小剧场第三季。第2集。食品过期不凑合。",
    "lines": [
      {
        "who": "gg",
        "text": "冰箱里有酸奶，日期糊成一团。"
      },
      {
        "who": "xw",
        "text": "闻着还行，喝！"
      },
      {
        "who": "gg",
        "text": "停。看清保质期，胀袋变味都别吃。"
      },
      {
        "who": "xw",
        "text": "差一天行吗？"
      },
      {
        "who": "gg",
        "text": "不确定就问大人，不拿肚子赌运气。"
      },
      {
        "who": "xw",
        "text": "我改吃新鲜的！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-03",
    "series": "光光安全小剧场第三季",
    "n": 3,
    "title": "打火机不是玩具",
    "announce": "请听。光光安全小剧场第三季。第3集。打火机不是玩具。",
    "lines": [
      {
        "who": "gg",
        "text": "桌上打火机一闪一闪。"
      },
      {
        "who": "xw",
        "text": "我玩火花！好看！"
      },
      {
        "who": "gg",
        "text": "火会咬人。打火机火柴归大人，小孩不碰。"
      },
      {
        "who": "xw",
        "text": "生日蜡烛呢？"
      },
      {
        "who": "gg",
        "text": "大人点，你许愿，吹灭也要有人看着。"
      },
      {
        "who": "xw",
        "text": "我许愿：不玩火！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-04",
    "series": "光光安全小剧场第三季",
    "n": 4,
    "title": "阳台窗户要站远",
    "announce": "请听。光光安全小剧场第三季。第4集。阳台窗户要站远。",
    "lines": [
      {
        "who": "gg",
        "text": "小问趴窗台看小鸟。"
      },
      {
        "who": "xw",
        "text": "再探一点！"
      },
      {
        "who": "gg",
        "text": "停。窗户阳台不爬不趴，脚下站稳。"
      },
      {
        "who": "xw",
        "text": "气球飞出去了我追？"
      },
      {
        "who": "gg",
        "text": "不追出窗外。东西掉了告诉大人。"
      },
      {
        "who": "xw",
        "text": "我退后两步！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-05",
    "series": "光光安全小剧场第三季",
    "n": 5,
    "title": "被欺负要说出来",
    "announce": "请听。光光安全小剧场第三季。第5集。被欺负要说出来。",
    "lines": [
      {
        "who": "gg",
        "text": "有人故意推你、骂你、藏你文具。"
      },
      {
        "who": "xw",
        "text": "我忍着，当没看见。"
      },
      {
        "who": "gg",
        "text": "不是胆小，是需要帮助。告诉老师和家里大人。"
      },
      {
        "who": "xw",
        "text": "说出来会更糟吗？"
      },
      {
        "who": "gg",
        "text": "藏着更糟。你不是麻烦，你是要被保护的人。"
      },
      {
        "who": "xw",
        "text": "我去找老师说！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-06",
    "series": "光光安全小剧场第三季",
    "n": 6,
    "title": "坐姿端正眼睛亮",
    "announce": "请听。光光安全小剧场第三季。第6集。坐姿端正眼睛亮。",
    "lines": [
      {
        "who": "gg",
        "text": "小问写字缩成小虾米。"
      },
      {
        "who": "xw",
        "text": "这样帅！"
      },
      {
        "who": "gg",
        "text": "眼睛和本子要有一拳距离，背要直。"
      },
      {
        "who": "xw",
        "text": "一拳？我的拳头吗？"
      },
      {
        "who": "gg",
        "text": "对。坐姿好，眼睛少加班。"
      },
      {
        "who": "xw",
        "text": "我把虾米拉直了！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-07",
    "series": "光光安全小剧场第三季",
    "n": 7,
    "title": "扶梯站稳扶好",
    "announce": "请听。光光安全小剧场第三季。第7集。扶梯站稳扶好。",
    "lines": [
      {
        "who": "gg",
        "text": "商场扶梯黄线闪闪。"
      },
      {
        "who": "xw",
        "text": "我跑上去！逆行超车！"
      },
      {
        "who": "gg",
        "text": "停。站稳，握住扶手，黄线里站好，不逆行。"
      },
      {
        "who": "xw",
        "text": "鞋带开了呢？"
      },
      {
        "who": "gg",
        "text": "到平面再系。扶梯上不弯腰捡东西。"
      },
      {
        "who": "xw",
        "text": "我当稳稳小乘客！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-08",
    "series": "光光安全小剧场第三季",
    "n": 8,
    "title": "危险挑战视频不跟",
    "announce": "请听。光光安全小剧场第三季。第8集。危险挑战视频不跟。",
    "lines": [
      {
        "who": "gg",
        "text": "短视频里有人爬高喝怪东西。"
      },
      {
        "who": "xw",
        "text": "好厉害！我也学！"
      },
      {
        "who": "gg",
        "text": "那是危险挑战。屏幕里作秀，现实里受伤。"
      },
      {
        "who": "xw",
        "text": "点赞很多就安全吗？"
      },
      {
        "who": "gg",
        "text": "点赞不是通行证。好奇就问大人，不模仿。"
      },
      {
        "who": "xw",
        "text": "我把手指从跟拍上拿开！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-09",
    "series": "光光安全小剧场第三季",
    "n": 9,
    "title": "密码钥匙不外传",
    "announce": "请听。光光安全小剧场第三季。第9集。密码钥匙不外传。",
    "lines": [
      {
        "who": "gg",
        "text": "同学借你家门锁密码。"
      },
      {
        "who": "xw",
        "text": "好朋友应该告诉吧？"
      },
      {
        "who": "gg",
        "text": "密码钥匙是家庭秘密，不外传，不写在书包上。"
      },
      {
        "who": "xw",
        "text": "游戏密码呢？"
      },
      {
        "who": "gg",
        "text": "也不随便给。像牙刷，自己用。"
      },
      {
        "who": "xw",
        "text": "我把秘密收好了！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-10",
    "series": "光光安全小剧场第三季",
    "n": 10,
    "title": "过敏要早告诉人",
    "announce": "请听。光光安全小剧场第三季。第10集。过敏要早告诉人。",
    "lines": [
      {
        "who": "gg",
        "text": "有人对花生、尘螨会过敏。"
      },
      {
        "who": "xw",
        "text": "我只是鼻子痒！"
      },
      {
        "who": "gg",
        "text": "痒、起疹、喘，都要告诉大人，别硬撑。"
      },
      {
        "who": "xw",
        "text": "春游能吃别人零食吗？"
      },
      {
        "who": "gg",
        "text": "不确定成分就先问。严重过敏要按医嘱带药。"
      },
      {
        "who": "xw",
        "text": "我学会先问再吃！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-11",
    "series": "光光安全小剧场第三季",
    "n": 11,
    "title": "迷路用地图和电话",
    "announce": "请听。光光安全小剧场第三季。第11集。迷路用地图和电话。",
    "lines": [
      {
        "who": "gg",
        "text": "旅游走散了，小问慌。"
      },
      {
        "who": "xw",
        "text": "我瞎跑找你们！"
      },
      {
        "who": "gg",
        "text": "先停。看路牌，打家人电话，找工作人员。"
      },
      {
        "who": "xw",
        "text": "跟陌生人回家更快？"
      },
      {
        "who": "gg",
        "text": "不。站在亮处等人，或去服务台。"
      },
      {
        "who": "xw",
        "text": "电话我背熟了！"
      }
    ]
  },
  {
    "id": "光光安全小剧场第三季-12",
    "series": "光光安全小剧场第三季",
    "n": 12,
    "title": "会打求助电话",
    "announce": "请听。光光安全小剧场第三季。第12集。会打求助电话。",
    "lines": [
      {
        "who": "gg",
        "text": "第三季收官：紧急时会打电话。"
      },
      {
        "who": "xw",
        "text": "110？120？我分不清！"
      },
      {
        "who": "gg",
        "text": "危险求助警察，生病受伤叫急救，火灾找消防。先报位置。"
      },
      {
        "who": "xw",
        "text": "开玩笑拨呢？"
      },
      {
        "who": "gg",
        "text": "不许。假报会耽误真有事的人。"
      },
      {
        "who": "xw",
        "text": "我记住了：真有事才拨，说清在哪。"
      },
      {
        "who": "gg",
        "text": "安全小剧场三季齐了。你越来越会护自己。"
      },
      {
        "who": "xw",
        "text": "谢谢光光！我们都是宝！"
      }
    ]
  }
]
