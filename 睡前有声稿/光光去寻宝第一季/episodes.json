[
  {
    "id": "光光去寻宝第一季-01",
    "series": "光光去寻宝第一季",
    "n": 1,
    "title": "四川的宝",
    "announce": "请听。光光去寻宝第一季。第1集。四川的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "哎，小问，今天咱们出门寻宝！"
      },
      {
        "who": "xw",
        "text": "寻宝？埋金子啊？挖土啊？我带小铲子了！"
      },
      {
        "who": "gg",
        "text": "打住打住。咱们寻的是好玩的知识宝。第一站——四川！"
      },
      {
        "who": "xw",
        "text": "四川！火锅！麻！辣！烫！"
      },
      {
        "who": "gg",
        "text": "火锅是宝，还有更软乎的宝——大熊猫。它吃竹子，一天能坐着啃十几小时。"
      },
      {
        "who": "xw",
        "text": "那它不饿吗？竹子看着像嚼草棍。"
      },
      {
        "who": "gg",
        "text": "竹子纤维多、能量低，所以它得一直吃。像你写作业，得一直写，才写得完。"
      },
      {
        "who": "xw",
        "text": "嘿——你损我！那四川还有啥宝？"
      },
      {
        "who": "gg",
        "text": "都江堰。古人把江水分流，既防洪水又浇田，两千多年还在干活。"
      },
      {
        "who": "xw",
        "text": "工程也算宝？"
      },
      {
        "who": "gg",
        "text": "当然。能让人少遭灾、多吃饭的，都是宝。下一集咱们去北京，听听胡同里藏着啥。"
      },
      {
        "who": "xw",
        "text": "走着！我不带铲子了，我带耳朵！"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-02",
    "series": "光光去寻宝第一季",
    "n": 2,
    "title": "北京的宝",
    "announce": "请听。光光去寻宝第一季。第2集。北京的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "北京站到！小问，你看那红墙黄瓦——"
      },
      {
        "who": "xw",
        "text": "宫殿！皇帝住的！我能当一天皇帝吗？"
      },
      {
        "who": "gg",
        "text": "当不了。但你可以当一天好奇宝宝。故宫里藏着的宝，不只是金杯子。"
      },
      {
        "who": "xw",
        "text": "那是啥？"
      },
      {
        "who": "gg",
        "text": "是设计。门多高、路多宽、怎么排水，都算得很清楚，下雨也不易淹。"
      },
      {
        "who": "xw",
        "text": "古人也会排水？我还以为只有现代管道。"
      },
      {
        "who": "gg",
        "text": "智慧不分朝代。再往胡同走，窄巷子里，邻居抬头就能打招呼。"
      },
      {
        "who": "xw",
        "text": "那隐私呢？我想躲猫猫都没地儿。"
      },
      {
        "who": "gg",
        "text": "所以城市有热闹，也有安静角落。寻宝不是抢东西，是学会怎么看一座城。"
      },
      {
        "who": "xw",
        "text": "明白了。下一站去哪？我想吃点心。"
      },
      {
        "who": "gg",
        "text": "广东。早茶等着你，但先听规矩：肚子要给知识留个座。"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-03",
    "series": "光光去寻宝第一季",
    "n": 3,
    "title": "广东的宝",
    "announce": "请听。光光去寻宝第一季。第3集。广东的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "广东到！小问，早茶来了，虾饺、肠粉、流沙包。"
      },
      {
        "who": "xw",
        "text": "我先吃三个！不，五个！"
      },
      {
        "who": "gg",
        "text": "等等。广东的宝不只在嘴里，还在海上的路。很早以前，船就从这边往外走，带着丝绸瓷器。"
      },
      {
        "who": "xw",
        "text": "那是快递吗？古代快递？"
      },
      {
        "who": "gg",
        "text": "算远程贸易。船一出海，风向、潮汐都得懂，不然货到不了。"
      },
      {
        "who": "xw",
        "text": "那船长也是科学家？"
      },
      {
        "who": "gg",
        "text": "是观察家。观察对了，路就通了。再告诉你个小宝：广东话说饮茶，不只是喝茶，是坐下来聊。"
      },
      {
        "who": "xw",
        "text": "那咱们现在算饮茶吗？你光说我不喝啊。"
      },
      {
        "who": "gg",
        "text": "口渴了喝水，心里渴了听故事。下一集陕西，土里站着一队不说话的兵。"
      },
      {
        "who": "xw",
        "text": "兵？会不会吓人？"
      },
      {
        "who": "gg",
        "text": "泥做的兵，不咬人。但能吓到偷懒的想象力。走！"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-04",
    "series": "光光去寻宝第一季",
    "n": 4,
    "title": "陕西的宝",
    "announce": "请听。光光去寻宝第一季。第4集。陕西的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "陕西。小问，闭眼，想象地下忽然站出一排兵马俑。"
      },
      {
        "who": "xw",
        "text": "啊！我睁开了！他们真站着吗？"
      },
      {
        "who": "gg",
        "text": "真的。每个表情、发型、鞋子细节都不完全一样。像班级合影，没有俩人一模一样。"
      },
      {
        "who": "xw",
        "text": "那是复制粘贴失败了？"
      },
      {
        "who": "gg",
        "text": "那是认真。古人用泥巴讲队伍和秩序。还有宝在碗里，一碗油泼面，热气能把眼镜糊住。"
      },
      {
        "who": "xw",
        "text": "我没眼镜，糊鼻子也行。"
      },
      {
        "who": "gg",
        "text": "吃之前先问一句：面从哪来？麦子怎么变成粉？这也是寻宝。"
      },
      {
        "who": "xw",
        "text": "寻宝越寻越饿。"
      },
      {
        "who": "gg",
        "text": "饿说明你活着。下一集浙江，湖边有诗，口袋里有丝。"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-05",
    "series": "光光去寻宝第一季",
    "n": 5,
    "title": "浙江的宝",
    "announce": "请听。光光去寻宝第一季。第5集。浙江的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "浙江。西湖水轻轻的，小问别跳下去找宝。"
      },
      {
        "who": "xw",
        "text": "我跳！……骗你的。水里有龙吗？"
      },
      {
        "who": "gg",
        "text": "没有龙，有故事。桥、堤、塔，名字背后常有人做过实事：修路、治水、种树。"
      },
      {
        "who": "xw",
        "text": "那宝是人做出来的？"
      },
      {
        "who": "gg",
        "text": "很多宝都是。丝绸也是，蚕吐丝，人织布，布能走很远。"
      },
      {
        "who": "xw",
        "text": "蚕宝宝加班加点啊。"
      },
      {
        "who": "gg",
        "text": "对。小生命也能撑起大买卖。你要是细心，作业本上的字也能变成你的宝。"
      },
      {
        "who": "xw",
        "text": "得，又教育我。下一站远吗？"
      },
      {
        "who": "gg",
        "text": "远一点：新疆。葡萄干甜，沙漠也不含糊。"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-06",
    "series": "光光去寻宝第一季",
    "n": 6,
    "title": "新疆的宝",
    "announce": "请听。光光去寻宝第一季。第6集。新疆的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "新疆大得很。小问，你猜宝在哪？"
      },
      {
        "who": "xw",
        "text": "哈密瓜里！一口甜到脚后跟！"
      },
      {
        "who": "gg",
        "text": "瓜是宝，葡萄干也是宝。阳光足、昼夜温差大，糖分爱往果子里钻。"
      },
      {
        "who": "xw",
        "text": "糖还会钻？太会挑地方了。"
      },
      {
        "who": "gg",
        "text": "还有绿洲：沙子中间忽然有水有树，像沙漠眨眼。人和动物都围着水生活。"
      },
      {
        "who": "xw",
        "text": "那水就是最大的宝？"
      },
      {
        "who": "gg",
        "text": "在干旱的地方，水比金子管用。寻宝要问：这儿缺什么，什么就珍贵。"
      },
      {
        "who": "xw",
        "text": "我家缺零食，零食珍贵。"
      },
      {
        "who": "gg",
        "text": "你赢了半句。下一集云南，山多、花多、味道也多。"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-07",
    "series": "光光去寻宝第一季",
    "n": 7,
    "title": "云南的宝",
    "announce": "请听。光光去寻宝第一季。第7集。云南的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "云南。山叠着山，小问腿软了没？"
      },
      {
        "who": "xw",
        "text": "软了。可我闻到花香了！还有菌子汤！"
      },
      {
        "who": "gg",
        "text": "慢着，野生菌不能乱采乱吃，有的有毒。宝也会咬人。"
      },
      {
        "who": "xw",
        "text": "吓我一跳。那安全的宝呢？"
      },
      {
        "who": "gg",
        "text": "多样。气候带多，植物动物种类也多，像自然的百宝箱。普洱茶能存很久，越存越有故事。"
      },
      {
        "who": "xw",
        "text": "茶叶也会长大吗？"
      },
      {
        "who": "gg",
        "text": "它会变化。时间参与制作，味道就变。人读书也一样，隔一年再读，懂的不一样。"
      },
      {
        "who": "xw",
        "text": "那我把故事存一年再听？"
      },
      {
        "who": "gg",
        "text": "可以。下一集福建，圆形大楼请你做客。"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-08",
    "series": "光光去寻宝第一季",
    "n": 8,
    "title": "福建的宝",
    "announce": "请听。光光去寻宝第一季。第8集。福建的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "福建土楼！小问，你看像不像巨型圆形饼干？"
      },
      {
        "who": "xw",
        "text": "我想啃一口。门在哪？窗户怎么这么小？"
      },
      {
        "who": "gg",
        "text": "早先为了聚族而居、也好守。大家住一圈，中间是公共场。"
      },
      {
        "who": "xw",
        "text": "那吵架能听见吗？"
      },
      {
        "who": "gg",
        "text": "听见了就得学着商量。建筑也是生活方式。再寻一口茶：岩茶、茉莉，泡开了满屋香。"
      },
      {
        "who": "xw",
        "text": "喝茶算运动吗？我举手升杯。"
      },
      {
        "who": "gg",
        "text": "算安静运动。心定了，眼睛也轻松点。下一集山东，爬山还是拜师？"
      },
      {
        "who": "xw",
        "text": "我选，先吃煎饼果子！"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-09",
    "series": "光光去寻宝第一季",
    "n": 9,
    "title": "山东的宝",
    "announce": "请听。光光去寻宝第一季。第9集。山东的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "山东。泰山高，孔子的故事也高。"
      },
      {
        "who": "xw",
        "text": "孔子会武功吗？"
      },
      {
        "who": "gg",
        "text": "他会问问题，会带学生讨论。学而时习之，就是学了还要练。"
      },
      {
        "who": "xw",
        "text": "像打游戏要多开几局？"
      },
      {
        "who": "gg",
        "text": "有点像，但学的是做人做事。泰山呢，一层一层往上，腿酸也要迈。"
      },
      {
        "who": "xw",
        "text": "那宝是坚持？"
      },
      {
        "who": "gg",
        "text": "坚持是开门的钥匙。门后还有海：海边吹风，眼睛看看远处，对护眼也友好。"
      },
      {
        "who": "xw",
        "text": "远处！我盯着海平线，哇，眼睛舒服了。"
      },
      {
        "who": "gg",
        "text": "这就寻到实用宝了。下一集黑龙江，冷，但粮仓暖和。"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-10",
    "series": "光光去寻宝第一季",
    "n": 10,
    "title": "黑龙江的宝",
    "announce": "请听。光光去寻宝第一季。第10集。黑龙江的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "黑龙江。冬天下雪，小问变雪人了。"
      },
      {
        "who": "xw",
        "text": "我阿嚏！宝会不会冻住？"
      },
      {
        "who": "gg",
        "text": "冻不住的宝叫黑土地：肥，适合种粮食。大豆、玉米，餐桌后面站着田野。"
      },
      {
        "who": "xw",
        "text": "原来我碗里的饭有户口在东北。"
      },
      {
        "who": "gg",
        "text": "对。冰雪也是宝，能滑能看。但出门要戴帽子手套，别逞强。"
      },
      {
        "who": "xw",
        "text": "帽子我戴两顶，暖和翻倍。"
      },
      {
        "who": "gg",
        "text": "翻倍的是安全。下一集海南，热乎乎的。"
      },
      {
        "who": "xw",
        "text": "我要把雪人外套脱了！"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-11",
    "series": "光光去寻宝第一季",
    "n": 11,
    "title": "海南的宝",
    "announce": "请听。光光去寻宝第一季。第11集。海南的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "海南。椰子树举手欢迎。小问，别把头伸进椰子壳。"
      },
      {
        "who": "xw",
        "text": "那壳能当房子吗？"
      },
      {
        "who": "gg",
        "text": "给你当杯子差不多。真正的宝是海洋：鱼、珊瑚、风向。海边的人很早就学会看天吃饭。"
      },
      {
        "who": "xw",
        "text": "看天真能吃饭？"
      },
      {
        "who": "gg",
        "text": "看天决定出不出海。乱出海，危险。宝旁边常贴着说明书：小心。"
      },
      {
        "who": "xw",
        "text": "说明书我最怕，字小。"
      },
      {
        "who": "gg",
        "text": "那就听我念：尊重海，海才让你玩。下一集上海，最后一站，灯火亮。"
      }
    ]
  },
  {
    "id": "光光去寻宝第一季-12",
    "series": "光光去寻宝第一季",
    "n": 12,
    "title": "上海的宝",
    "announce": "请听。光光去寻宝第一季。第12集。上海的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "上海。外滩的灯，像把星星拉到河边。"
      },
      {
        "who": "xw",
        "text": "好亮！这是宝吗？电费谁出？"
      },
      {
        "who": "gg",
        "text": "亮光背后是城市运转：港口、铁路、弄堂里的烟火气。"
      },
      {
        "who": "xw",
        "text": "弄堂窄，会不会撞脸？"
      },
      {
        "who": "gg",
        "text": "会遇见人。遇见人，就会有故事。第一季寻宝到此收官：四川到上海，我们寻的不是口袋鼓，是脑袋亮。"
      },
      {
        "who": "xw",
        "text": "我脑袋亮了吗？你照照。"
      },
      {
        "who": "gg",
        "text": "你一问一接，已经在发光。想安全不踩坑，去听光光安全小剧场。"
      },
      {
        "who": "xw",
        "text": "走着，我保护我的宝，我自己！"
      }
    ]
  }
]