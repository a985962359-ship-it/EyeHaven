[
  {
    "id": "光光安全小剧场-01",
    "series": "光光安全小剧场",
    "n": 1,
    "title": "陌生人给糖也不走",
    "announce": "请听。光光安全小剧场。第1集。陌生人给糖也不走。",
    "lines": [
      {
        "who": "gg",
        "text": "开场！安全小剧场第一集。"
      },
      {
        "who": "xw",
        "text": "有糖！有车！有叔叔笑！我去吗？"
      },
      {
        "who": "gg",
        "text": "停。笑和糖不是通行证。不认识的人叫你上车，你就站定。"
      },
      {
        "who": "xw",
        "text": "那我咋办？喊你？"
      },
      {
        "who": "gg",
        "text": "喊旁边的大人，或跑向人多的地方。记住：不跟走、不关门、不大意。"
      },
      {
        "who": "xw",
        "text": "那我妈妈的朋友呢？"
      },
      {
        "who": "gg",
        "text": "要你家大人先跟你约定暗号。没暗号，就不走。"
      },
      {
        "who": "xw",
        "text": "暗号是土豆炖牛肉！"
      },
      {
        "who": "gg",
        "text": "行，私下定，别到处广播。记住：你自己是最大的宝。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-02",
    "series": "光光安全小剧场",
    "n": 2,
    "title": "过马路眼睛要上班",
    "announce": "请听。光光安全小剧场。第2集。过马路眼睛要上班。",
    "lines": [
      {
        "who": "gg",
        "text": "马路像河，车是大鱼。"
      },
      {
        "who": "xw",
        "text": "我游过去！快！"
      },
      {
        "who": "gg",
        "text": "你会变成惊吓条。红灯停，绿灯行，还要左右看。"
      },
      {
        "who": "xw",
        "text": "看手机行吗？"
      },
      {
        "who": "gg",
        "text": "不行。眼睛留给路和车。斑马线上也不猛跑，司机需要反应时间。"
      },
      {
        "who": "xw",
        "text": "那我迟到了怎么办？"
      },
      {
        "who": "gg",
        "text": "迟到比受伤便宜。安全第一，面子第二。"
      },
      {
        "who": "xw",
        "text": "面子放口袋里，命放心里。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-03",
    "series": "光光安全小剧场",
    "n": 3,
    "title": "热水也会咬人",
    "announce": "请听。光光安全小剧场。第3集。热水也会咬人。",
    "lines": [
      {
        "who": "gg",
        "text": "厨房剧场：热汤、热油、热水壶。"
      },
      {
        "who": "xw",
        "text": "我帮着倒！我勇敢！"
      },
      {
        "who": "gg",
        "text": "勇敢用错地方叫莽撞。大人倒热水，小孩离远点，杯子放稳。"
      },
      {
        "who": "xw",
        "text": "烫到手怎么办？"
      },
      {
        "who": "gg",
        "text": "先冲凉水，别涂奇怪东西，严重就找大人去医院。"
      },
      {
        "who": "xw",
        "text": "凉水是急救伙伴？"
      },
      {
        "who": "gg",
        "text": "对。伙伴不烫嘴，也不吹牛。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-04",
    "series": "光光安全小剧场",
    "n": 4,
    "title": "电梯里的冷静按钮",
    "announce": "请听。光光安全小剧场。第4集。电梯里的冷静按钮。",
    "lines": [
      {
        "who": "gg",
        "text": "叮，电梯门开了。"
      },
      {
        "who": "xw",
        "text": "我挤！门要关了我用手挡！"
      },
      {
        "who": "gg",
        "text": "别用手挡门，更别扒门。进电梯先看人，不跟可疑陌生人单独进。"
      },
      {
        "who": "xw",
        "text": "卡住了呢？"
      },
      {
        "who": "gg",
        "text": "按报警铃，打电话，等救援。别爬、别跳、别拆天花板当超人。"
      },
      {
        "who": "xw",
        "text": "超人也会等电梯？"
      },
      {
        "who": "gg",
        "text": "真超人最会等专业的人。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-05",
    "series": "光光安全小剧场",
    "n": 5,
    "title": "网上的钩子不咬",
    "announce": "请听。光光安全小剧场。第5集。网上的钩子不咬。",
    "lines": [
      {
        "who": "gg",
        "text": "手机亮了：免费礼物，点开就有！"
      },
      {
        "who": "xw",
        "text": "点！我要飞船！"
      },
      {
        "who": "gg",
        "text": "钩子来了。陌生链接、陌生加好友、要你密码验证码，都不给。"
      },
      {
        "who": "xw",
        "text": "那同学借密码呢？"
      },
      {
        "who": "gg",
        "text": "密码像牙刷，不共用。游戏里有人叫你私下转账，更要喊大人。"
      },
      {
        "who": "xw",
        "text": "我把钩子掰弯！"
      },
      {
        "who": "gg",
        "text": "掰弯的方法是：先问大人，再决定点不点。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-06",
    "series": "光光安全小剧场",
    "n": 6,
    "title": "眼睛累了先停",
    "announce": "请听。光光安全小剧场。第6集。眼睛累了先停。",
    "lines": [
      {
        "who": "gg",
        "text": "小问，你盯屏幕盯成化石了。"
      },
      {
        "who": "xw",
        "text": "再玩一分钟！就一分钟！"
      },
      {
        "who": "gg",
        "text": "一分钟常常变成十一分钟。眼睛酸、眨眼少，就是警报。"
      },
      {
        "who": "xw",
        "text": "警报怎么关？"
      },
      {
        "who": "gg",
        "text": "先停。看远处，眨眨眼，起来走走。护眼不是输赢，是保养。"
      },
      {
        "who": "xw",
        "text": "那我听完这集再停？"
      },
      {
        "who": "gg",
        "text": "听完，停。说到做到，才算安全剧场合格。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-07",
    "series": "光光安全小剧场",
    "n": 7,
    "title": "药不是糖豆",
    "announce": "请听。光光安全小剧场。第7集。药不是糖豆。",
    "lines": [
      {
        "who": "gg",
        "text": "药瓶花花绿绿，像糖。"
      },
      {
        "who": "xw",
        "text": "一颗！甜的吧？"
      },
      {
        "who": "gg",
        "text": "不是。药要按医嘱，大人给多少吃多少，自己不拆瓶。"
      },
      {
        "who": "xw",
        "text": "吃多了会怎样？"
      },
      {
        "who": "gg",
        "text": "可能很难受，甚至危险。误吃了立刻告诉大人，必要时去医院。"
      },
      {
        "who": "xw",
        "text": "糖豆留给真正的糖。"
      },
      {
        "who": "gg",
        "text": "聪明。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-08",
    "series": "光光安全小剧场",
    "n": 8,
    "title": "走丢了找谁",
    "announce": "请听。光光安全小剧场。第8集。走丢了找谁。",
    "lines": [
      {
        "who": "gg",
        "text": "商场好大，小问转个弯，人呢？"
      },
      {
        "who": "xw",
        "text": "爸爸妈妈！咦？"
      },
      {
        "who": "gg",
        "text": "别乱跑更远。站在原地，或去服务台、收银台找工作人员。"
      },
      {
        "who": "xw",
        "text": "跟好心人回家吗？"
      },
      {
        "who": "gg",
        "text": "不。等你家大人来接。可以说出父母电话，让可靠的工作人员帮你打。"
      },
      {
        "who": "xw",
        "text": "我把电话背熟了！"
      },
      {
        "who": "gg",
        "text": "这就是你的随身宝。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-09",
    "series": "光光安全小剧场",
    "n": 9,
    "title": "危险玩笑不许开",
    "announce": "请听。光光安全小剧场。第9集。危险玩笑不许开。",
    "lines": [
      {
        "who": "gg",
        "text": "有人喊着玩：着火了！救命！"
      },
      {
        "who": "xw",
        "text": "哈哈哈，逗你们的！"
      },
      {
        "who": "gg",
        "text": "这笑话冷。真有事时，别人不信了，就像狼来了。"
      },
      {
        "who": "xw",
        "text": "那幽默还能有吗？"
      },
      {
        "who": "gg",
        "text": "能。幽默不拿生命、火灾、报警开玩笑。玩笑有边界，边界叫安全。"
      },
      {
        "who": "xw",
        "text": "我改口：着凉了，加衣服！"
      },
      {
        "who": "gg",
        "text": "这都行。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-10",
    "series": "光光安全小剧场",
    "n": 10,
    "title": "玩水要有大人陪",
    "announce": "请听。光光安全小剧场。第10集。玩水要有大人陪。",
    "lines": [
      {
        "who": "gg",
        "text": "夏天，水花哗啦。"
      },
      {
        "who": "xw",
        "text": "我自己跳进去玩！"
      },
      {
        "who": "gg",
        "text": "停。玩水必须有大人陪同，近到伸手能拉住你。"
      },
      {
        "who": "xw",
        "text": "救生圈够了吧？"
      },
      {
        "who": "gg",
        "text": "圈不能代替大人。小伙伴也不能代替大人。"
      },
      {
        "who": "xw",
        "text": "没大人就不下水？"
      },
      {
        "who": "gg",
        "text": "对。没大人陪，不玩水。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-11",
    "series": "光光安全小剧场",
    "n": 11,
    "title": "厨房刀具不是玩具",
    "announce": "请听。光光安全小剧场。第11集。厨房刀具不是玩具。",
    "lines": [
      {
        "who": "gg",
        "text": "刀光一闪。"
      },
      {
        "who": "xw",
        "text": "我切水果给光光！"
      },
      {
        "who": "gg",
        "text": "谢谢心意，但刀具归大人用。小孩用安全餐具，切的事先说一声。"
      },
      {
        "who": "xw",
        "text": "剪刀剪纸呢？"
      },
      {
        "who": "gg",
        "text": "圆头安全剪可以，尖的、大的留给大人。用完放回原处，不藏枕头下。"
      },
      {
        "who": "xw",
        "text": "枕头下只放梦。"
      },
      {
        "who": "gg",
        "text": "完美台词。"
      }
    ]
  },
  {
    "id": "光光安全小剧场-12",
    "series": "光光安全小剧场",
    "n": 12,
    "title": "家里的逃生小排练",
    "announce": "请听。光光安全小剧场。第12集。家里的逃生小排练。",
    "lines": [
      {
        "who": "gg",
        "text": "最后一集：假如烟雾报警器响了？"
      },
      {
        "who": "xw",
        "text": "我藏被子里！"
      },
      {
        "who": "gg",
        "text": "不。低姿快走，捂口鼻，按家里商量好的路线出门，去约定集合点。"
      },
      {
        "who": "xw",
        "text": "电梯？"
      },
      {
        "who": "gg",
        "text": "火灾不乘电梯，走楼梯。平时和大人排一次，像做游戏，但不笑场误事。"
      },
      {
        "who": "xw",
        "text": "我们排练过，我记得出门左转。"
      },
      {
        "who": "gg",
        "text": "好。安全小剧场十二集齐了：规则记心里，胆子用对地方。下回寻宝见！"
      },
      {
        "who": "xw",
        "text": "见！我保护我的宝，我和我的家人！"
      }
    ]
  }
]
