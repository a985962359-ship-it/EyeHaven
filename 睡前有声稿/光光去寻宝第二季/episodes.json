[
  {
    "id": "光光去寻宝第二季-01",
    "series": "光光去寻宝第二季",
    "n": 1,
    "title": "河南的宝",
    "announce": "请听。光光去寻宝第二季。第1集。河南的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "第二季开张！小问，河南到了。"
      },
      {
        "who": "xw",
        "text": "河南？我只会说胡辣汤！"
      },
      {
        "who": "gg",
        "text": "汤是宝，地下还有更老的宝——殷墟。很早以前这儿有文字刻在骨头上，叫甲骨文。"
      },
      {
        "who": "xw",
        "text": "骨头上写字？疼不疼？"
      },
      {
        "who": "gg",
        "text": "那是占卜用的，不是往人骨头上刻。字一留下来，历史就会说话。"
      },
      {
        "who": "xw",
        "text": "那少林寺呢？武功也算宝？"
      },
      {
        "who": "gg",
        "text": "功夫是身体的语言。更重要的是：练功先练规矩，跟听故事先坐好一样。"
      },
      {
        "who": "xw",
        "text": "我坐好了。下一站？"
      },
      {
        "who": "gg",
        "text": "湖南。辣，但别光顾着伸舌头。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-02",
    "series": "光光去寻宝第二季",
    "n": 2,
    "title": "湖南的宝",
    "announce": "请听。光光去寻宝第二季。第2集。湖南的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "湖南。小问，辣椒伺候！"
      },
      {
        "who": "xw",
        "text": "啊——喷火！宝在辣里吗？"
      },
      {
        "who": "gg",
        "text": "辣是特色。还有山水：张家界的山像从地上长出来的积木。"
      },
      {
        "who": "xw",
        "text": "我能当孙悟空跳过去吗？"
      },
      {
        "who": "gg",
        "text": "电影里能，现实里请走栈道。安全也是宝。再告诉你：湖广一带人爱读书、爱辩论，嘴勤脑也勤。"
      },
      {
        "who": "xw",
        "text": "那我嘴勤算勤学？"
      },
      {
        "who": "gg",
        "text": "嘴勤问为什么，才算。下一集湖北，江河大。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-03",
    "series": "光光去寻宝第二季",
    "n": 3,
    "title": "湖北的宝",
    "announce": "请听。光光去寻宝第二季。第3集。湖北的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "湖北。长江从这儿身边走过。"
      },
      {
        "who": "xw",
        "text": "我喊一声，对岸听得见吗？"
      },
      {
        "who": "gg",
        "text": "听不见，但船听得见号子。江既是路，也是考题：洪水来了怎么办？"
      },
      {
        "who": "xw",
        "text": "跑？还是修？"
      },
      {
        "who": "gg",
        "text": "古人筑堤、测水，现在有更科学的办法。宝是会与江相处。黄鹤楼的诗也是宝：人走了，字留下。"
      },
      {
        "who": "xw",
        "text": "那我把笑话留下行吗？"
      },
      {
        "who": "gg",
        "text": "留下不伤人的笑话。下一集重庆，山城。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-04",
    "series": "光光去寻宝第二季",
    "n": 4,
    "title": "重庆的宝",
    "announce": "请听。光光去寻宝第二季。第4集。重庆的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "重庆。路是楼梯，街是坡。"
      },
      {
        "who": "xw",
        "text": "我的腿在抗议！火锅又来了？"
      },
      {
        "who": "gg",
        "text": "火锅香，但宝还有轻轨穿楼：城市挤在山上，交通要想妙招。"
      },
      {
        "who": "xw",
        "text": "火车钻楼？魔术吗？"
      },
      {
        "who": "gg",
        "text": "工程。雾多、江多，人就学会垂直搬家。小问，爬山别低头玩手机。"
      },
      {
        "who": "xw",
        "text": "我低头看路！……手机在口袋。"
      },
      {
        "who": "gg",
        "text": "好。下一集贵州，桥多。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-05",
    "series": "光光去寻宝第二季",
    "n": 5,
    "title": "贵州的宝",
    "announce": "请听。光光去寻宝第二季。第5集。贵州的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "贵州。山连山，桥连桥。"
      },
      {
        "who": "xw",
        "text": "我恐高！桥会不会晃？"
      },
      {
        "who": "gg",
        "text": "大桥是算出来的。还有黄果树瀑布，水的力量看得见。"
      },
      {
        "who": "xw",
        "text": "水也会寻宝？"
      },
      {
        "who": "gg",
        "text": "水寻低处，人寻道理。贵州还有茅台酒乡，但小朋友的宝是酸汤鱼和好好吃饭。"
      },
      {
        "who": "xw",
        "text": "酒给我一口？"
      },
      {
        "who": "gg",
        "text": "一口空气。下一集西藏，高处的宝。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-06",
    "series": "光光去寻宝第二季",
    "n": 6,
    "title": "西藏的宝",
    "announce": "请听。光光去寻宝第二季。第6集。西藏的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "西藏。天近，走慢一点。"
      },
      {
        "who": "xw",
        "text": "我喘！氧气去哪了？"
      },
      {
        "who": "gg",
        "text": "海拔高，空气薄。这是自然课：身体要适应，不能硬冲。"
      },
      {
        "who": "xw",
        "text": "那宝是牦牛吗？毛茸茸的。"
      },
      {
        "who": "gg",
        "text": "牦牛、青稞、阳光下的经幡，都是高原生活的答案。更珍贵的是：尊重本地人和规矩。"
      },
      {
        "who": "xw",
        "text": "我不乱扔瓶子。"
      },
      {
        "who": "gg",
        "text": "这就寻到文明宝了。下一集内蒙古，风大。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-07",
    "series": "光光去寻宝第二季",
    "n": 7,
    "title": "内蒙古的宝",
    "announce": "请听。光光去寻宝第二季。第7集。内蒙古的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "内蒙古。草原像绿毯子。"
      },
      {
        "who": "xw",
        "text": "我滚！……草扎脖子。"
      },
      {
        "who": "gg",
        "text": "宝是辽阔，也是畜牧智慧：哪里草好，哪里安家。马背上看天，知道风雨。"
      },
      {
        "who": "xw",
        "text": "那牛奶从哪来？我猜到了！"
      },
      {
        "who": "gg",
        "text": "聪明。蒙古包能拆能搬，像会走路的家。下一集甘肃，走廊细长。"
      },
      {
        "who": "xw",
        "text": "走廊？家里那种？"
      },
      {
        "who": "gg",
        "text": "河西走廊。走！"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-08",
    "series": "光光去寻宝第二季",
    "n": 8,
    "title": "甘肃的宝",
    "announce": "请听。光光去寻宝第二季。第8集。甘肃的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "甘肃。敦煌莫高窟，墙上会讲故事。"
      },
      {
        "who": "xw",
        "text": "墙上长漫画？"
      },
      {
        "who": "gg",
        "text": "壁画、彩塑，是古人的连环画，也是丝绸之路的脚印。"
      },
      {
        "who": "xw",
        "text": "我能摸吗？"
      },
      {
        "who": "gg",
        "text": "不能摸。宝怕手油。看，用眼睛；记，用脑子。沙漠边的绿洲提醒我们：水少的地方，更珍惜。"
      },
      {
        "who": "xw",
        "text": "我水杯抱紧了。"
      },
      {
        "who": "gg",
        "text": "下一集宁夏，虽小故事多。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-09",
    "series": "光光去寻宝第二季",
    "n": 9,
    "title": "宁夏的宝",
    "announce": "请听。光光去寻宝第二季。第9集。宁夏的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "宁夏。塞上江南，有黄河水浇田。"
      },
      {
        "who": "xw",
        "text": "沙漠旁边还能种地？"
      },
      {
        "who": "gg",
        "text": "灌溉是宝。枸杞红红的，也是这儿的名片。"
      },
      {
        "who": "xw",
        "text": "我当零食吃？"
      },
      {
        "who": "gg",
        "text": "适量。西夏陵沉默地躺着，提醒我们：王朝会过去，教训留下来。"
      },
      {
        "who": "xw",
        "text": "教训是什么？"
      },
      {
        "who": "gg",
        "text": "善待土地和人。下一集青海，湖像镜子。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-10",
    "series": "光光去寻宝第二季",
    "n": 10,
    "title": "青海的宝",
    "announce": "请听。光光去寻宝第二季。第10集。青海的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "青海。青海湖圆圆的。"
      },
      {
        "who": "xw",
        "text": "我跳进去当鸭子！"
      },
      {
        "who": "gg",
        "text": "别。湖要保护，鸟要安静。高原上的盐湖、油菜花，颜色都很会说话。"
      },
      {
        "who": "xw",
        "text": "花会说话？说什么？"
      },
      {
        "who": "gg",
        "text": "说：夏天短，抓紧开花。人也一样，好事要抓紧做，别拖。"
      },
      {
        "who": "xw",
        "text": "那我抓紧听完这一集。"
      },
      {
        "who": "gg",
        "text": "好。下一集辽宁，海与工业都有故事。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-11",
    "series": "光光去寻宝第二季",
    "n": 11,
    "title": "辽宁的宝",
    "announce": "请听。光光去寻宝第二季。第11集。辽宁的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "辽宁。一边是海，一边是老工业的肩膀。"
      },
      {
        "who": "xw",
        "text": "肩膀？机器也有肩膀？"
      },
      {
        "who": "gg",
        "text": "造船、炼钢，曾经扛起很多建设。现在海边还能看老虎滩、吃海鲜——但海鲜要新鲜、要适量。"
      },
      {
        "who": "xw",
        "text": "我适量……再加一盘。"
      },
      {
        "who": "gg",
        "text": "沈阳故宫比北京故宫小巧，说明帝王足迹不只一处。宝是多样。"
      },
      {
        "who": "xw",
        "text": "下一站收官吗？"
      },
      {
        "who": "gg",
        "text": "收官在天津。相声老家，咱们得正经逗一逗。"
      }
    ]
  },
  {
    "id": "光光去寻宝第二季-12",
    "series": "光光去寻宝第二季",
    "n": 12,
    "title": "天津的宝",
    "announce": "请听。光光去寻宝第二季。第12集。天津的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "天津。码头、洋楼、煎饼果子。"
      },
      {
        "who": "xw",
        "text": "果子！我先咬！烫！"
      },
      {
        "who": "gg",
        "text": "还有更对口的宝：相声。一逗一捧，把日子说明白。"
      },
      {
        "who": "xw",
        "text": "那咱俩算不算天津制造？"
      },
      {
        "who": "gg",
        "text": "算精神学徒。海河穿城，租界老楼提醒历史层层叠叠。第二季寻宝到此：从河南到天津，脑袋又亮一圈。"
      },
      {
        "who": "xw",
        "text": "第三季呢？"
      },
      {
        "who": "gg",
        "text": "先把安全小剧场第二季听完，保护好寻宝的人。"
      },
      {
        "who": "xw",
        "text": "走着！我是宝，也护宝！"
      }
    ]
  }
]