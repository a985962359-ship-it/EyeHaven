[
  {
    "id": "光光去寻宝第三季-01",
    "series": "光光去寻宝第三季",
    "n": 1,
    "title": "江苏的宝",
    "announce": "请听。光光去寻宝第三季。第1集。江苏的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "第三季开张！小问，江苏到了。"
      },
      {
        "who": "xw",
        "text": "江苏？我只会说大闸蟹！"
      },
      {
        "who": "gg",
        "text": "蟹是宝，园林也是宝。苏州园林把山和水请到院子里。"
      },
      {
        "who": "xw",
        "text": "院子里装得下山？魔术吗？"
      },
      {
        "who": "gg",
        "text": "是设计：假山、水池、回廊，走路就像翻风景页。"
      },
      {
        "who": "xw",
        "text": "那南京的城墙呢？"
      },
      {
        "who": "gg",
        "text": "城墙厚，护过城。宝不只好吃，还要会看。下一站安徽。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-02",
    "series": "光光去寻宝第三季",
    "n": 2,
    "title": "安徽的宝",
    "announce": "请听。光光去寻宝第三季。第2集。安徽的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "安徽。黄山石头奇，云海像棉花糖。"
      },
      {
        "who": "xw",
        "text": "我咬一口云！"
      },
      {
        "who": "gg",
        "text": "咬不到。但徽派房子白墙黑瓦，像水墨画站起来。"
      },
      {
        "who": "xw",
        "text": "墙上怎么长瓦？"
      },
      {
        "who": "gg",
        "text": "那是马头墙，防火又好看。还有宣纸，写字画画都靠它。"
      },
      {
        "who": "xw",
        "text": "我的涂鸦也算宝？"
      },
      {
        "who": "gg",
        "text": "认真画、认真想，就靠近宝了。下一站江西。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-03",
    "series": "光光去寻宝第三季",
    "n": 3,
    "title": "江西的宝",
    "announce": "请听。光光去寻宝第三季。第3集。江西的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "江西。景德镇，瓷器之乡。"
      },
      {
        "who": "xw",
        "text": "碗也会发光吗？"
      },
      {
        "who": "gg",
        "text": "好瓷轻轻敲会唱歌。还有庐山瀑布，飞流直下——但你别学飞。"
      },
      {
        "who": "xw",
        "text": "我站稳看！"
      },
      {
        "who": "gg",
        "text": "对。瓷器用火与土做成，耐心是宝。"
      },
      {
        "who": "xw",
        "text": "我耐心等下一集。"
      },
      {
        "who": "gg",
        "text": "下一站河北。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-04",
    "series": "光光去寻宝第三季",
    "n": 4,
    "title": "河北的宝",
    "announce": "请听。光光去寻宝第三季。第4集。河北的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "河北。长城在这儿也很威风。"
      },
      {
        "who": "xw",
        "text": "我当城墙守卫！"
      },
      {
        "who": "gg",
        "text": "守卫要懂历史：长城是连起来的防线，也是看风景的路。"
      },
      {
        "who": "xw",
        "text": "承德避暑山庄凉快吗？"
      },
      {
        "who": "gg",
        "text": "名字就写着凉快。皇帝夏天办公也在园子里想办法。"
      },
      {
        "who": "xw",
        "text": "我也想凉快办公——写作业算吗？"
      },
      {
        "who": "gg",
        "text": "算。下一站山西。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-05",
    "series": "光光去寻宝第三季",
    "n": 5,
    "title": "山西的宝",
    "announce": "请听。光光去寻宝第三季。第5集。山西的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "山西。平遥古城像时光盒子。"
      },
      {
        "who": "xw",
        "text": "打开有金币吗？"
      },
      {
        "who": "gg",
        "text": "有更老的宝：票号。古人用银票做生意，像早期银行。"
      },
      {
        "who": "xw",
        "text": "那我开小问银行！"
      },
      {
        "who": "gg",
        "text": "先学诚信。还有老陈醋，酸得清醒。"
      },
      {
        "who": "xw",
        "text": "我闻一下就醒了！"
      },
      {
        "who": "gg",
        "text": "下一站吉林。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-06",
    "series": "光光去寻宝第三季",
    "n": 6,
    "title": "吉林的宝",
    "announce": "请听。光光去寻宝第三季。第6集。吉林的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "吉林。长白山天池圆圆的。"
      },
      {
        "who": "xw",
        "text": "天掉下来的镜子？"
      },
      {
        "who": "gg",
        "text": "像。雾凇是树上开的冰花，冬天特有的宝。"
      },
      {
        "who": "xw",
        "text": "我摘一朵？"
      },
      {
        "who": "gg",
        "text": "看就好，手一碰容易坏。还有人参，是药用植物，不是零食。"
      },
      {
        "who": "xw",
        "text": "我不乱啃树根。"
      },
      {
        "who": "gg",
        "text": "聪明。下一站广西。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-07",
    "series": "光光去寻宝第三季",
    "n": 7,
    "title": "广西的宝",
    "announce": "请听。光光去寻宝第三季。第7集。广西的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "广西。桂林山水甲天下。"
      },
      {
        "who": "xw",
        "text": "山为什么尖尖的？"
      },
      {
        "who": "gg",
        "text": "喀斯特地貌，水把石头慢慢雕成峰林。"
      },
      {
        "who": "xw",
        "text": "水也会当雕刻家？"
      },
      {
        "who": "gg",
        "text": "会。还有螺蛳粉——香得有个性。"
      },
      {
        "who": "xw",
        "text": "我勇敢尝一口！"
      },
      {
        "who": "gg",
        "text": "勇敢也要适量。下一站台湾。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-08",
    "series": "光光去寻宝第三季",
    "n": 8,
    "title": "台湾的宝",
    "announce": "请听。光光去寻宝第三季。第8集。台湾的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "台湾。阿里山火车慢慢爬。"
      },
      {
        "who": "xw",
        "text": "我当小火车头！"
      },
      {
        "who": "gg",
        "text": "宝是山林与海：水果甜，夜市热闹，但礼节要记得。"
      },
      {
        "who": "xw",
        "text": "夜市我先吃三串！"
      },
      {
        "who": "gg",
        "text": "适量。两岸孩子都爱听故事，故事是连心的桥。"
      },
      {
        "who": "xw",
        "text": "那咱俩也是桥？"
      },
      {
        "who": "gg",
        "text": "算小桥。下一站香港。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-09",
    "series": "光光去寻宝第三季",
    "n": 9,
    "title": "香港的宝",
    "announce": "请听。光光去寻宝第三季。第9集。香港的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "香港。维港灯火像撒了一地星星。"
      },
      {
        "who": "xw",
        "text": "捡一颗回家！"
      },
      {
        "who": "gg",
        "text": "灯是城市运转的光。还有叮叮车，叮一声就拐弯。"
      },
      {
        "who": "xw",
        "text": "叮！我拐了！"
      },
      {
        "who": "gg",
        "text": "港口让世界的货在这儿碰头。宝是开放与秩序。"
      },
      {
        "who": "xw",
        "text": "我排队也算秩序？"
      },
      {
        "who": "gg",
        "text": "算。下一站澳门。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-10",
    "series": "光光去寻宝第三季",
    "n": 10,
    "title": "澳门的宝",
    "announce": "请听。光光去寻宝第三季。第10集。澳门的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "澳门。大三巴牌坊站了很多年。"
      },
      {
        "who": "xw",
        "text": "门去哪了？"
      },
      {
        "who": "gg",
        "text": "岁月留下门脸，像历史的相框。街上中西建筑肩并肩。"
      },
      {
        "who": "xw",
        "text": "蛋挞！我闻到了！"
      },
      {
        "who": "gg",
        "text": "蛋挞香，但更香的是：不同文化能好好相处。"
      },
      {
        "who": "xw",
        "text": "我和光光也相处得很好！"
      },
      {
        "who": "gg",
        "text": "下一站深圳。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-11",
    "series": "光光去寻宝第三季",
    "n": 11,
    "title": "深圳的宝",
    "announce": "请听。光光去寻宝第三季。第11集。深圳的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "深圳。从前小渔村，现在创新忙。"
      },
      {
        "who": "xw",
        "text": "变变变！魔术城市？"
      },
      {
        "who": "gg",
        "text": "是人努力加开放。科技园里想法变产品。"
      },
      {
        "who": "xw",
        "text": "我发明会讲笑话的勺子！"
      },
      {
        "who": "gg",
        "text": "先发明会坚持的习惯。改革春风从这儿吹得很远。"
      },
      {
        "who": "xw",
        "text": "吹到我作业上了吗？"
      },
      {
        "who": "gg",
        "text": "吹到认真两个字上。下一集收官。"
      }
    ]
  },
  {
    "id": "光光去寻宝第三季-12",
    "series": "光光去寻宝第三季",
    "n": 12,
    "title": "祖国地图上的宝",
    "announce": "请听。光光去寻宝第三季。第12集。祖国地图上的宝。",
    "lines": [
      {
        "who": "gg",
        "text": "第三季收官：摊开祖国地图。"
      },
      {
        "who": "xw",
        "text": "好多点！我眼睛转晕了！"
      },
      {
        "who": "gg",
        "text": "每一省一城都有宝：山水、故事、味道、发明。"
      },
      {
        "who": "xw",
        "text": "那最大的宝是啥？"
      },
      {
        "who": "gg",
        "text": "爱提问的你，和愿意听答案的心。"
      },
      {
        "who": "xw",
        "text": "我发光了吗？"
      },
      {
        "who": "gg",
        "text": "亮了。下回安全小剧场第三季，护住发光的人。"
      },
      {
        "who": "xw",
        "text": "走着！我护宝，也护自己！"
      }
    ]
  }
]
